<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-hosted music servers are often reached over plain HTTP on a home network, so cleartext
  is allowed. The app's own services (MetaBrainz, LRCLIB) use HTTPS regardless, and the sign-in
  screen warns when a server address isn't HTTPS.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
