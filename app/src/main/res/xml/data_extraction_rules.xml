<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. The music server sign-in (auth token) is never backed up or transferred, nor are
    offline downloads (large, and tied to the server sign-in) and their Media3 index.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="subsonic.xml" />
        <exclude domain="external" path="downloads/" />
        <exclude domain="database" path="exoplayer_internal.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="subsonic.xml" />
        <exclude domain="external" path="downloads/" />
        <exclude domain="database" path="exoplayer_internal.db" />
    </device-transfer>
</data-extraction-rules>
